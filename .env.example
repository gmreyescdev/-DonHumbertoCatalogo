# PLANTILLA. Este archivo SÍ se sube a git, así que nunca debe llevar datos
# reales: ni contraseñas, ni cadenas de conexión, ni claves.
#
# Cópialo como .env y completa allí los valores. El .env está excluido de git.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------

# Conexión que usa la aplicación.
#   Local:      la entrega `npm run db:dev`
#   Producción: la URL de Neon CON el sufijo -pooler en el host
DATABASE_URL="postgresql://usuario:clave@host-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Solo en producción: la misma URL pero SIN el sufijo -pooler.
# `prisma migrate` la necesita porque el pooler no soporta sus locks.
# En local se deja vacía: se usa DATABASE_URL.
MIGRATE_DATABASE_URL=""

# Solo en local: base auxiliar y DESECHABLE que Prisma usa al CREAR migraciones.
# La entrega `npm run db:dev`.
# CUIDADO: Prisma borra por completo la base que se indique aquí. Nunca apuntarla
# a una base con datos reales. En producción se deja vacía.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------

# Clave con la que se firman las sesiones. Mínimo 32 caracteres.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si la cambias, todos tienen que volver a entrar.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Primer administrador (lo crea `npm run db:seed`)
# ---------------------------------------------------------------------------

ADMIN_EMAIL="tu-correo@ejemplo.cl"
ADMIN_PASSWORD="una-clave-larga-y-secreta"
ADMIN_NOMBRE="Administrador"

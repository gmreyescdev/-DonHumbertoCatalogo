# Copia este archivo como .env y completa los valores.
# El .env nunca se sube a git.

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------

# Conexión que usa la aplicación.
#   Local:      la entrega `npm run db:dev`
#   Producción: la URL "Pooled connection" de Neon / Vercel Postgres
DATABASE_URL="postgres://usuario:clave@host/basededatos?sslmode=require"

# Solo en producción: la URL "Direct connection" (sin pooler) de Neon.
# `prisma migrate` la necesita porque el pooler no soporta sus locks.
# En local se deja vacía: se usa DATABASE_URL.
MIGRATE_DATABASE_URL=""

# Solo en local: base auxiliar que Prisma usa al CREAR migraciones nuevas.
# La entrega `npm run db:dev`. En producción se deja vacía.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------------

# Clave con la que se firman las sesiones. Mínimo 32 caracteres.
# Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Si la cambias, todos tienen que volver a entrar.
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Primer administrador (lo crea `npm run db:seed`)
# ---------------------------------------------------------------------------

ADMIN_EMAIL="tu-correo@ejemplo.cl"
ADMIN_PASSWORD="una-clave-larga-y-secreta"
ADMIN_NOMBRE="Administrador"
